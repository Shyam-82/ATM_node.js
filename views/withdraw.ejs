<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Withdraw</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">

    <h1>💸 Withdraw Money</h1>

    <form action="/withdraw" method="POST">

        <input
            type="number"
            name="amount"
            placeholder="Enter Amount"
            required
        >

        <button type="submit">
            Withdraw
        </button>

    </form>

</div>

</body>
</html>