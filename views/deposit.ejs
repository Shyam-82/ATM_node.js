<!DOCTYPE html>
<html>
<head>
    <title>Deposit</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">

    <h1>💰 Deposit Money</h1>

    <form action="/deposit" method="POST">

        <input
            type="number"
            name="amount"
            placeholder="Enter Amount"
            required
        >

        <button type="submit">
            Deposit
        </button>

    </form>

</div>

</body>
</html>