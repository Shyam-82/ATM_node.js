<!DOCTYPE html>
<html>
<head>
    <title>Transfer Money</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="dashboard">

    <h1>💸 Transfer Money</h1>

    <form action="/transfer" method="POST">

        <input type="text" name="accountNumber" placeholder="Receiver Account Number" required>

        <input type="number" name="amount" placeholder="Amount" required>

        <button type="submit" class="atm-btn">Transfer</button>

    </form>

</div>

</body>
</html>